<mujoco>
  <visual>
    <global offwidth="1920" offheight="1080" fovy="60" />
    <scale framelength="0.5" framewidth="0.05" />
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2=".6 .8 1" width="256" height="256"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <model name="ur5" file="ur5e_no_lim.xml"/>
  </asset>

  <worldbody>
    <light pos="1.5 1.5 5.0" diffuse="2 1.9 1.9"/>
    <light pos="-1.5 -1.5 5.0" diffuse="2 1.9 1.9"/>

    <geom name="floor" pos="0 0 -0.05" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="ur5_1_" pos="-0.6 -0.5 0.02" euler="0 0 0" mocap="true">
      <attach model="ur5" body="base" prefix="ur5_1/"/>
    </body>
    <body name="ur5_2_" pos="0.6 -0.5 0.02" euler="0 0 180" mocap="true">
      <attach model="ur5" body="base" prefix="ur5_2/"/>
    </body>


    <body name="ur5_1/target" pos="0.5 0 .5" quat="0 1 0 1" mocap="true">
      <geom type="box" size=".03 .03 .03" contype="0" conaffinity="0" rgba=".6 .3 .3 .2"/>
    </body>

    <body name="ur5_2/target" pos="0.5 0 .5" quat="0 1 0 1" mocap="true">
      <geom type="box" size=".03 .03 .03" contype="0" conaffinity="0" rgba=".6 .3 .3 .2"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home" qpos="
    0 -0.7854 0 -2.1817 0 1.3962 
    0 -0.7854 0 -2.1817 0 1.3962"
      />
  </keyframe>
</mujoco>
